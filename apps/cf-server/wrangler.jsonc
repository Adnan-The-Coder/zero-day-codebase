/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "zero-day-cf-server",
	"main": "src/index.ts",
	"compatibility_date": "2025-09-10",
	"assets": {
		"binding": "ASSETS",
		"directory": "./public"
	},
	"observability": {
		"enabled": true
	},
  "vars": {
    "ENVIRONMENT": "development"
  },
  "d1_databases": [  // Optional: keep dev config here
    {
      "binding": "DB",
      "database_name": "zero-day-db",
      "database_id": "562aec8a-1c05-4435-89ef-eb4999cd8b9b",
      "migrations_dir": "./drizzle"
    }
  ],
  "env": {
    "production": {
      "vars": {
        "ENVIRONMENT": "production"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "zero-day-db",
          "database_id": "562aec8a-1c05-4435-89ef-eb4999cd8b9b",
          "migrations_dir": "./drizzle"
        }
      ]
    },
    "staging": {
      "vars": {
        "ENVIRONMENT": "staging"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "zero-day-db",
          "database_id": "562aec8a-1c05-4435-89ef-eb4999cd8b9b",
          "migrations_dir": "./drizzle"
        }
      ]
    }
  }
}